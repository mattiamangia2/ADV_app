# Copy to .env (which git ignores) and adjust. Never put real secrets in this example file.
PORT=4000
# SQLite file location (default: server/data/adv.db)
ADV_DB_PATH=
# Time zone used for hour-of-day analytics
ADV_TZ=Europe/Rome
# Set to 0 to start with an empty database instead of demo data
ADV_SEED=1
